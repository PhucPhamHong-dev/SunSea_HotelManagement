NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECRET=replace-with-a-local-only-secret
AUTH_COOKIE_NAME=hotel_session
AUTH_USERNAME_DOMAIN=sunsea.local
AUTH_REFRESH_COOKIE_MAX_AGE_DAYS=3650
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_SECRET=replace-with-local-jwt-secret
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REALTIME_ENABLED=true
REALTIME_CHANNEL=hotel-events
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@sunsea.local
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-local-password
