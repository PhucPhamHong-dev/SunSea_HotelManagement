# Copy this template to /opt/sunsea/.env on the VPS. Never commit that real file.
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh

NEXT_PUBLIC_API_BASE_URL=https://sunsea.phucpink.io.vn
NEXT_PUBLIC_WS_URL=https://sunsea.phucpink.io.vn
FRONTEND_URL=https://sunsea.phucpink.io.vn
CORS_ORIGINS=https://sunsea.phucpink.io.vn

AUTH_COOKIE_NAME=hotel_session
AUTH_USERNAME_DOMAIN=sunsea.local
AUTH_REFRESH_COOKIE_MAX_AGE_DAYS=3650
COOKIE_SECRET=<generate-a-long-random-secret>

SUPABASE_URL=<supabase-project-url>
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
DATABASE_URL=<supabase-transaction-pooler-url>
DIRECT_URL=<supabase-session-pooler-url>
SUPABASE_DB_URL=<supabase-session-pooler-url>

REALTIME_ENABLED=true
REALTIME_CHANNEL=hotel-events
LOG_LEVEL=info
